# Copy to .env and fill in. Never commit .env. No value here is a real secret.

# --- Go API (backend/go-services/api) ---------------------------------------
DATABASE_URL=postgres://eagle:eagle_dev_password@localhost:5434/eagle?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
MIGRATE_ON_START=true
LOG_LEVEL=info
# CORS is off unless origins are listed (the Android app doesn't need it).
# CORS_ALLOWED_ORIGINS=https://admin.example.com

# Auth, option A: Neon Auth (staging/production). Everything else is derived:
#   JWKS = <base>/.well-known/jwks.json, issuer = audience = origin of <base>
# NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.<region>.aws.neon.tech/neondb/auth

# Auth, option B: local dev issuer (`make devauth`). LOCAL ONLY.
AUTH_JWKS_URL=http://localhost:8787/.well-known/jwks.json
AUTH_ISSUER=http://localhost:8787
AUTH_AUDIENCE=http://localhost:8787

# --- Tests -------------------------------------------------------------------
TEST_DATABASE_URL=postgres://eagle:eagle_dev_password@localhost:5434/eagle_test?sslmode=disable
